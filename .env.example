# Copy to .env (never commit .env). Choose one provider.
LLM_PROVIDER=anthropic        # anthropic | openai | mock
LLM_MODEL=claude-haiku-5-5    # optional override
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional tuning (CR-12). Keep LLM_MAX_CONCURRENCY x LLM_MAX_TOKENS under your
# account's output-tokens-per-minute limit (see console.anthropic.com/settings/limits).
# LLM_MAX_CONCURRENCY=5
# LLM_MAX_TOKENS=12000
# LLM_MAX_RETRIES=6
